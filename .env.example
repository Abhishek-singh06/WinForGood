# ==============================================================================
# DIGITAL HEROES — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# DO NOT STORE PRODUCTION SECRETS OR SENSITIVE KEYS IN THIS FILE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION HOSTING
# ------------------------------------------------------------------------------
# REQUIRED FOR: LOCAL, STAGING, PRODUCTION
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. SUPABASE INFRASTRUCTURE (Database, Auth, Row Level Security)
# ------------------------------------------------------------------------------
# Mandated by PRD § 15.1: Use dedicated project instance
# REQUIRED FOR: LOCAL (if connecting to remote DB), STAGING, PRODUCTION
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server Service Role Key (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT)
# REQUIRED FOR: STAGING, PRODUCTION (Used by Stripe Webhook & Admin Background Services)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage Bucket for Winner Scorecard Verification
# OPTIONAL (Defaults to 'winner-proofs')
SUPABASE_WINNER_PROOFS_BUCKET=winner-proofs

# ------------------------------------------------------------------------------
# 3. STRIPE PAYMENT GATEWAY (PCI-Compliant Billing)
# ------------------------------------------------------------------------------
# Mandated by PRD § 04: Stripe integration for Monthly/Yearly subscriptions
# REQUIRED FOR: STAGING, PRODUCTION
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_MONTHLY_PRICE_ID=price_monthly_placeholder
STRIPE_YEARLY_PRICE_ID=price_yearly_placeholder

# ------------------------------------------------------------------------------
# 4. TEMPORARY COMMERCIAL ASSUMPTIONS (Phase 5/7 Configuration Fallbacks)
# ------------------------------------------------------------------------------
# Current default assumptions:
# Currency: GBP (£)
# Monthly: £10.00 (1000 pence)
# Yearly: £100.00 (10000 pence)
# Prize Pool: 30% of eligible subscription revenue
# Charity Floor: 10% minimum
